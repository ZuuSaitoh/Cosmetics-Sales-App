<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Quyền truy cập -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    
    <!-- ============ NOTIFICATION PERMISSIONS ============ -->
    <!-- Permission để hiển thị notification (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Permission để notification rung -->
    <uses-permission android:name="android.permission.VIBRATE" />
    
    <!-- Permission để nhận broadcast khi device khởi động lại -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!-- Permission để hiển thị badge trên app icon (một số devices) -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="com.android.launcher.permission.UNINSTALL_SHORTCUT" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Activity khởi chạy chính -->
        <activity
            android:name=".ActivityWelcome"
            android:exported="true"
            android:theme="@style/Theme.MyApplication" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <activity
            android:name=".ActivityAdminMain"
            android:exported="true"
            android:theme="@style/Theme.MyApplication" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- Các Activity khác -->

        <activity
            android:name=".ActivityMain"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".ActivityCheckout"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".ActivityOrderHistory"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".ActivityOrderSuccess"
            android:exported="false"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".OrderFailedActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".VNPayActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".ActivityOrderDetail"
            android:exported="false"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".ActivityLogin"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication" />
        <activity
            android:name=".ActivitySignUp"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".ActivityForgotPassword"
            android:exported="false"
            android:label="Quên mật khẩu"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".ActivityOtpVerification"
            android:exported="false"
            android:label="Xác thực OTP"
            android:theme="@style/Theme.MyApplication" />
        
        <activity
            android:name=".ActivityResetPassword"
            android:exported="false"
            android:label="Đặt lại mật khẩu"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".AdminDashboardActivity"
            android:exported="false"
            android:label="Quản lý nhân viên"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".ActivityCart"
            android:exported="false"
            android:label="Giỏ hàng"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".ProductDetailActivity"
            android:exported="false"
            android:label="Chi tiết sản phẩm"
            android:theme="@style/Theme.MyApplication" />

        <!-- Nếu bạn có thêm MapsActivity -->
        <activity
            android:name=".map.MapsActivity"
            android:exported="false"
            android:label="Bản đồ"
            android:theme="@style/Theme.MyApplication" />
        <activity
            android:name=".map.MapsNavigationActivity"
            android:exported="false"
            android:label="Bản đồ"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".ActivityUpdateProfile"
            android:exported="false"
            android:label="Chỉnh sửa thông tin"
            android:theme="@style/Theme.MyApplication" />
        
        <activity
            android:name=".AdminActivity"
            android:exported="false"
            android:label="Trang quản trị"
            android:theme="@style/Theme.MyApplication" />
        
        <activity
            android:name=".notification.NotificationListActivity"
            android:exported="false"
            android:label="Thông báo"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:label="Chat Support"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".CategoryProductsActivity"
            android:exported="false"
            android:label="Sản phẩm theo danh mục"
            android:theme="@style/Theme.MyApplication" />

        <service
            android:name="vn.vietmap.services.android.navigation.v5.navigation.NavigationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- ============ NOTIFICATION COMPONENTS ============ -->
        <!-- BroadcastReceiver để xử lý notification actions -->
        <receiver
            android:name=".notification.NotificationReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.myapplication.NOTIFICATION_DISMISSED" />
                <action android:name="com.example.myapplication.NOTIFICATION_CLICKED" />
                <action android:name="com.example.myapplication.VIEW_CART" />
            </intent-filter>
        </receiver>

        <!-- BroadcastReceiver để restore notification sau khi restart device -->
        <receiver
            android:name=".notification.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
