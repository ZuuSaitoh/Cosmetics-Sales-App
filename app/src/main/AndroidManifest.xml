<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Quyền truy cập -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Activity khởi chạy chính .Main-->
        <activity
            android:name=".ActivityWelcome"
            android:exported="true"
            android:theme="@style/Theme.MyApplication" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- Các Activity khác -->

        <activity
            android:name=".Main"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".ActivityLogin"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication" />
        <activity
            android:name=".ActivitySignUp"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".AdminDashboardActivity"
            android:exported="false"
            android:label="Quản lý nhân viên"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".CartActivity"
            android:exported="false"
            android:label="Giỏ hàng"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".ProductDetailActivity"
            android:exported="false"
            android:label="Chi tiết sản phẩm"
            android:theme="@style/Theme.MyApplication" />

        <!-- Nếu bạn có thêm MapsActivity -->
        <activity
            android:name=".map.MapsActivity"
            android:exported="false"
            android:label="Bản đồ"
            android:theme="@style/Theme.MyApplication" />
        <activity
            android:name=".map.MapsNavigationActivity"
            android:exported="false"
            android:label="Bản đồ"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".ActivityUpdateProfile"
            android:exported="false"
            android:label="Chỉnh sửa thông tin"
            android:theme="@style/Theme.MyApplication" />
        
        <activity
            android:name=".AdminActivity"
            android:exported="false"
            android:label="Trang quản trị"
            android:theme="@style/Theme.MyApplication" />

        <service
            android:name="vn.vietmap.services.android.navigation.v5.navigation.NavigationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>

</manifest>
