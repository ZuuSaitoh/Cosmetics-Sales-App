<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/brand_secondary</item>

        <item name="materialThemeOverlay">@style/ThemeOverlay.MaterialComponents</item>
    </style>

    <style name="Widget.App.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>

        <item name="boxBackgroundColor">@android:color/transparent</item>
        <item name="android:background">@drawable/text_input_background</item>

        <item name="startIconTint">@android:color/darker_gray</item>
        <item name="hintTextColor">@android:color/darker_gray</item>
        <item name="android:textColorHint">@android:color/darker_gray</item>
    </style>
    <style name="RatingBar" parent="Theme.AppCompat">
        <item name="colorControlNormal">#D3D3D3</item> <item name="colorControlActivated">#FFC107</item> </style>
</resources>