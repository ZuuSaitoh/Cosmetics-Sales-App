<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/orderDetailLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Thanh tiêu đề -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#00695C"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:title="Chi tiết đơn hàng"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:titleCentered="true" />

    <!-- Layout chính cuộn được -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Thông tin đơn hàng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/tvOrderId"
                    android:text="Mã đơn hàng: #123456"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvOrderDate"
                    android:text="Ngày đặt: 20/10/2025"
                    android:textColor="#555555"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvOrderStatus"
                    android:text="Trạng thái: Chờ xử lý"
                    android:textColor="#00695C"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Danh sách sản phẩm -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sản phẩm"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginTop="20dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrderItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="8dp" />

            <!-- Địa chỉ giao hàng -->
            <TextView
                android:text="Địa chỉ giao hàng"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nguyễn Văn A, 123 Đường ABC, TP.HCM"
                android:layout_marginTop="4dp"
                android:textColor="#555555" />

            <!-- Phương thức thanh toán -->
            <TextView
                android:text="Phương thức thanh toán"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/tvPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thanh toán khi nhận hàng (COD)"
                android:layout_marginTop="4dp"
                android:textColor="#555555" />

            <!-- Tổng cộng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_card"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/tvSubtotal"
                    android:text="Tạm tính: 500.000đ"
                    android:textColor="#555555" />

                <TextView
                    android:id="@+id/tvShippingFee"
                    android:text="Phí vận chuyển: 20.000đ"
                    android:textColor="#555555"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvTotal"
                    android:text="Tổng cộng: 520.000đ"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Nút hủy đơn (chỉ hiện khi trạng thái = "Chờ xử lý") -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelOrder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hủy đơn hàng"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:layout_margin="16dp"
        android:backgroundTint="#D32F2F"
        android:visibility="gone"
        app:cornerRadius="12dp"
        app:layout_anchorGravity="bottom" />

    <!-- Progress loading -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
