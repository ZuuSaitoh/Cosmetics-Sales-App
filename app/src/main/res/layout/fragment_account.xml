<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Header thông tin -->
        <LinearLayout
            android:id="@+id/layoutProfileHeader"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/avatarImageView"
                android:src="@drawable/ic_user"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_circle"
                android:padding="8dp" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tvFullName"
                    android:text="C. Nhi"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvPhone"
                    android:text="0868877813"
                    android:textSize="14sp"
                    android:textColor="#666"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <ImageView
                android:src="@drawable/ic_next"
                android:layout_width="24dp"
                android:layout_height="24dp" />
        </LinearLayout>

        <!-- Chỉ giữ lại nút Đăng xuất -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:layout_marginTop="16dp"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/layoutLogout"
                android:orientation="horizontal"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <ImageView
                    android:src="@drawable/ic_logout"
                    android:layout_width="24dp"
                    android:layout_height="24dp" />

                <TextView
                    android:text="Đăng xuất"
                    android:layout_marginStart="12dp"
                    android:textSize="15sp"
                    android:textColor="#000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:src="@drawable/ic_arrow_right"
                    android:layout_width="20dp"
                    android:layout_height="20dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hotline & Giờ hoạt động -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:layout_marginTop="16dp"
            android:padding="12dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/btnWorkingHours"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="8:00 - 22:00"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="#2E7D32"/>

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp"/>

                <TextView
                    android:id="@+id/btnHotline"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="2"
                    android:gravity="center"
                    android:text="1800 6324 (Miễn phí)"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="#F57C00"/>
            </LinearLayout>

            <!-- Danh sách chi nhánh -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CN 1: 71 Hoàng Hoa Thám, P.13, Q.Tân Bình, TP.HCM"
                android:textColor="#000"
                android:layout_marginTop="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CN 2: 555 Đường 3 Tháng 2, P.8, Q.10, TP.HCM"
                android:textColor="#000"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CN 3: 176 Phan Đăng Lưu, P.3, Q.Phú Nhuận, TP.HCM"
                android:textColor="#000"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CN 4: 94 Lê Văn Việt, P.Hiệp Phú, Q.9, TP.HCM"
                android:textColor="#9E9E9E"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tvSeeAllBranches"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xem 288 chi nhánh"
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_gravity="center_horizontal"/>
        </LinearLayout>

        <!-- Cho phép nhận thông báo -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cho phép nhận thông báo"
                android:textColor="#000"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchNotifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
