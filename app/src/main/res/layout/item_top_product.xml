<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@color/cosmetic_card_bg">

    <ImageView
        android:id="@+id/img_product"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/img_no_product"
        android:scaleType="centerCrop"
        android:layout_gravity="center_vertical"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_product_name"
            android:text="Tên sản phẩm"
            android:textColor="@color/cosmetic_text_primary"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_sales_count"
            android:text="Đã bán: 0"
            android:textColor="@color/cosmetic_text_secondary"
            android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
