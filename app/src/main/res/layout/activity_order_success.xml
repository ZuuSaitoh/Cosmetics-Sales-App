<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Icon thành công -->
<!--        <ImageView-->
<!--            android:id="@+id/ivSuccess"-->
<!--            android:layout_width="120dp"-->
<!--            android:layout_height="120dp"-->
<!--            android:layout_marginTop="80dp"-->
<!--            android:src="@drawable/ic_success"-->
<!--            android:contentDescription="Thành công"-->
<!--            app:tint="#00695C" />-->

        <!-- Tiêu đề -->
        <TextView
            android:id="@+id/tvSuccessTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="Đặt hàng thành công!"
            android:textColor="#00695C"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Thông tin đơn hàng -->
        <TextView
            android:id="@+id/tvOrderInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Cảm ơn bạn đã mua sắm.\nĐơn hàng của bạn sẽ sớm được xử lý."
            android:textAlignment="center"
            android:textColor="#424242"
            android:textSize="15sp" />

        <!-- Mã đơn hàng -->
        <LinearLayout
            android:id="@+id/layoutOrderCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center">

<!--            <TextView-->
<!--                android:text="Mã đơn hàng:"-->
<!--                android:textColor="#757575"-->
<!--                android:textSize="15sp" />-->

            <TextView
                android:id="@+id/tvOrderCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="DH20251022"
                android:textColor="#00695C"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tổng tiền -->
        <LinearLayout
            android:id="@+id/layoutTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center">

<!--            <TextView-->
<!--                android:text="Tổng tiền:"-->
<!--                android:textColor="#757575"-->
<!--                android:textSize="15sp" />-->

            <TextView
                android:id="@+id/tvTotalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="1.000.000đ"
                android:textColor="#00695C"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Nút hành động -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewOrders"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="48dp"
            android:text="Xem đơn hàng của tôi"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#00695C"
            app:cornerRadius="12dp"
            app:elevation="2dp"
            app:rippleColor="#80FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Về trang chủ"
            android:textColor="#00695C"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#E0F2F1"
            app:cornerRadius="12dp"
            app:elevation="1dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
