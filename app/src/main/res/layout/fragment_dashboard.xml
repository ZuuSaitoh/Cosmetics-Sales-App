<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cosmetic_bg_soft"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/cosmetic_primary"
            android:title="Dashboard"
            android:titleTextColor="@color/cosmetic_white"
            app:menu="@menu/menu_dashboard" />

        <!-- Cards thống kê -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                style="@style/MetricCardStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView android:text="Doanh thu"
                        android:textColor="@color/cosmetic_text_secondary"
                        android:textSize="12sp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                    <TextView android:id="@+id/tv_revenue_value"
                        android:text="₫0"
                        android:textColor="@color/cosmetic_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                style="@style/MetricCardStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView android:text="Tổng đơn"
                        android:textColor="@color/cosmetic_text_secondary"
                        android:textSize="12sp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                    <TextView android:id="@+id/tv_total_orders_value"
                        android:text="0"
                        android:textColor="@color/cosmetic_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                style="@style/MetricCardStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView android:text="Đang giao"
                        android:textColor="@color/cosmetic_text_secondary"
                        android:textSize="12sp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                    <TextView android:id="@+id/tv_shipping_value"
                        android:text="0"
                        android:textColor="@color/cosmetic_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Placeholder chart -->
        <androidx.cardview.widget.CardView
            style="@style/MetricCardStyle"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="12dp">
            <TextView
                android:text="Biểu đồ (Chart Placeholder)"
                android:textColor="@color/cosmetic_text_secondary"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.cardview.widget.CardView>

        <!-- Danh sách top sản phẩm -->
        <TextView
            android:text="Top sản phẩm bán chạy"
            android:textColor="@color/cosmetic_text_primary"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="12dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_top_products"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
